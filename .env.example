# Path to the TinyDB JSON file (relative paths resolve from the project root)
DATABASE_PATH=data/airline.json
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed by CORS
FRONTEND_URL=http://localhost:5173
# Number of days of future flight schedules generated on first start
SEED_DAYS=60

# JWT signing secret — set a long random value in any shared environment
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60

# Connection rules (minimum connecting time / maximum layover)
MIN_CONNECTION_DOMESTIC_MINUTES=60
MIN_CONNECTION_INTERNATIONAL_MINUTES=90
MAX_CONNECTION_DOMESTIC_HOURS=4
MAX_CONNECTION_INTERNATIONAL_HOURS=24

# Departure timeline
CHECKIN_OPENS_HOURS=48
CHECKIN_CLOSES_MINUTES=240
BOARDING_OPENS_MINUTES=60
BOARDING_CLOSES_MINUTES=30

# Bookings
BOOKING_HOLD_MINUTES=30
CHANGE_WINDOW_DAYS=60
# Base URL of the UI; hosted payment links are {PUBLIC_UI_URL}/pay/{session_id}
PUBLIC_UI_URL=http://localhost:5173
SEED_RANDOM_SEED=2026
